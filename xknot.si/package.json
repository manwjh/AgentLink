{
  "name": "xknot-si",
  "version": "0.3.0",
  "description": "XKnot 联邦中枢门户",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node ops/validate-instances.mjs && node ops/validate-federation.mjs",
    "validate:fixtures": "node ops/validate-instances.mjs --instances fixtures/preview-instances.json",
    "validate:federation": "node ops/validate-federation.mjs",
    "probe": "node ops/check-health.mjs",
    "watch-health": "node ops/watch-health.mjs",
    "traffic": "node ops/traffic.mjs",
    "status": "node ops/node-status.mjs",
    "fetch": "node ops/fetch-profile.mjs && node ops/fetch-cards.mjs && node ops/fetch-stats.mjs",
    "fetch:profile": "node ops/fetch-profile.mjs",
    "fetch:cards": "node ops/fetch-cards.mjs",
    "fetch:stats": "node ops/fetch-stats.mjs",
    "dev": "node ops/dev.mjs --preview",
    "dev:real": "node ops/dev.mjs",
    "preview": "npm --prefix web run preview",
    "build": "./ops/build-hub.sh",
    "build:preview": "./ops/build-hub.sh --preview",
    "republish": "node ops/republish.mjs",
    "verify": "node ops/verify-hub-data.mjs",
    "seo:check": "node ops/seo-check.mjs",
    "test": "node --test ops/*.test.mjs server/*.test.mjs web/src/lib/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.test.mjs",
    "test:ui": "npm --prefix e2e test",
    "test:ui:headed": "npm --prefix e2e run test:headed",
    "test:all": "npm test && npm run test:e2e && npm run test:ui",
    "deploy:local": "./ops/deploy-local.sh",
    "api": "node server/index.mjs",
    "mail:test": "node server/mail-test.mjs",
    "admin": "node server/admin-cli.mjs",
    "deploy": "./ops/deploy-hub.sh",
    "deploy:api": "./ops/deploy-api.sh",
    "build:world": "node ops/build-world-dots.mjs"
  },
  "devDependencies": {
    "marked": "^18.1.1"
  }
}
