# 实例运行时配置模板。由 packages/knot-config/src/schema.mjs 生成。
#
# 实例主机上的 sites/<站点>/platform.env 由 deploy-site.sh 写入：
#   * 站点与端口从 sites/<站点>/site.env 来；
#   * 下面的邮件、价格、存储键只在文件里还没有时写入初值，之后归运维。
#
# 这个文件不含站点拓扑；域名、主机、入口、端口写 site.env。
# 也不含任何 XKnot 接入凭据；委托发信与实例 id 写在 xknot.env。

# ---- 邮件 ----
# SMTP 主机。要和发信地址（MAIL_FROM 或 SMTP_FROM）一起才算配置好；两样都没有、又没有委托发信凭据时，登录接口返回 mail_unavailable，登录密钥寄不出去。
# 例：smtp.example.com
# SMTP_HOST=
# SMTP 端口。
SMTP_PORT=587
# 465 端口从第一包就要 TLS，写 1；587 用 STARTTLS 时保持 0。
SMTP_SECURE=0
# SMTP 用户名。
# SMTP_USER=
# SMTP 密码。
# SMTP_PASS=
# 发信地址。没配 MAIL_FROM 时用这个；两样都空等于没有本机 SMTP。
# SMTP_FROM=
# 发信地址，优先于 SMTP_FROM。登录密钥与建议投诉信都用它作发信人。
# MAIL_FROM=

# ---- 商店 ----
# 1 表示开启 Knot Store：/store 页面与网页、Agent 的商店接口都可用。0 关闭整套商店，页面和接口一起消失，已上架与成交的数据保留，改成 1 重启 Backend 即恢复。
KNOT_STORE_ENABLED=0

# ---- 经济 ----
# 消费券面值（积分）。
KNOT_DEFAULT_PRICE=10
# 商品可标的最低积分，至少为 1。
KNOT_PRICE_MIN=1
# 商品可标的最高积分。
KNOT_PRICE_MAX=100
# 发布服务费：每 MB 附件收多少积分，向上取整。
KNOT_PUBLISH_SERVICE_FEE_PER_MB=1
# 单次服务费上限。0 表示不封顶。
KNOT_SERVICE_FEE_CAP=10
# 新账户注册赠送积分。
KNOT_SIGNUP_GRANT=100
# 单次赠送上限。
KNOT_GRANT_MAX=100000
# 每积分的美元价，用美分表示（1 = 0.01 美元）。
KNOT_POINT_USD_CENTS=1
# 累计充值（美元）。本期占位 0。
KNOT_RECHARGE_USD=0
# 月运营开支（美元），用于盈亏平衡测算。
KNOT_MONTHLY_OPEX_USD=10000

# ---- 消费券 ----
# 券面值（积分）。留空等于 KNOT_DEFAULT_PRICE。
# KNOT_COUPON_FACE=
# 券有效期（天）。
KNOT_COUPON_TTL_DAYS=30
# 每个账户持有的未使用券上限。
KNOT_COUPON_MAX=1
# 新注册自动发一张：1 开，0 关。
KNOT_COUPON_SIGNUP=1

# ---- 存储 ----
# 每人上传字节上限。0 表示不限。
KNOT_UPLOAD_QUOTA_BYTES=1073741824
# 回收无引用上传的宽限期（小时）。
KNOT_GC_GRACE_HOURS=24
# 单张图片上限。WebUI 会先在浏览器里压到这个值以内；同时要小于入口 nginx 的请求体上限（52m，由中枢生成）。
KNOT_UPLOAD_IMAGE_MAX_BYTES=16777216
# 单条音频上限。
KNOT_UPLOAD_AUDIO_MAX_BYTES=8388608
# 单个附件上限。必须小于入口 nginx 的请求体上限（52m，由中枢生成），否则大文件在入口就被截断。
KNOT_UPLOAD_ATTACHMENT_MAX_BYTES=52428800
# 公开快照目录。留空用 <UPLOAD_DIR>/board。
# DISCOVER_BOARD_DIR=

# ---- 检索 ----
# 一次检索最多收进内存打分的候选行数。索引先挡掉不可能命中的行，这里是内存墙。
KNOT_SEARCH_CANDIDATES=2000
# 一次检索最多返回几条。
KNOT_SEARCH_RESULTS=30
# 检索词长度上限（字符）。超出的部分截断，不报错。
KNOT_SEARCH_Q_MAX=120
# 检索结果缓存时长（秒）。0 表示不缓存。内容有变更时会立即作废。
KNOT_SEARCH_CACHE_TTL=30
# 同一身份每分钟的检索次数上限。0 表示不限。
KNOT_SEARCH_RATE_PER_MIN=120
# 终审队列同时处理几条。
KNOT_REVIEW_CONCURRENCY=2
# 检索打点 search_events 保留天数。0 表示永久保留。
KNOT_SEARCH_EVENT_RETENTION_DAYS=90

# ---- 智能体 ----
# openclaw 可执行文件。
OPENCLAW_BIN=openclaw
# 终审这一回合的上限（秒），也是整条记录里给终审预留的时间。图片转写只能用总预算减去它的部分。
OPENCLAW_PROCESS_TIMEOUT=120
# 一条记录从开始到放弃的总预算（秒）：图片转写与终审共用这一份。
OPENCLAW_REVIEW_BUDGET=240
# 单张图片转写的上限（秒）。超时的那张跳过，不影响这一条的终审。
OPENCLAW_IMAGE_TIMEOUT=75
# 同一条记录里同时转写几张图片。
OPENCLAW_IMAGE_PARALLEL=2
# 情报智能体名。
OPENCLAW_INTEL_AGENT=knot-intel

# ---- 管理令牌 ----
# 内网管理接口 /api/admin 和管理后台 /admin 的令牌。由 ensure-openclaw.sh 写入，运维不要手改。
# KNOT_ADMIN_TOKEN=
# 管理后台链接里写死的内网地址，形如 http://<内网地址>:<KNOT_PORT>。留空时按 KNOT_BIND_HOST 与网卡推断。
# 例：http://<内网地址>:8080
# KNOT_ADMIN_ORIGIN=

